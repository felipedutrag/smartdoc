"use client";

import React, { useState } from "react";
import { useGeminiLive } from "@/hooks/use-gemini-live";
import { useIsBreakpoint } from "@/hooks/use-is-breakpoint";
import { globalAudioPlayer } from "@/utils/audio-player";

/* ── Orb Component ──────────────────────────────────────────────────────── */
function Orb({ size = 260, isActive = false, audioLevel = 0 }: { size?: number | string, isActive?: boolean, audioLevel?: number }) {
  return (
    <div
      className="orb-container"
      style={{
        width: size,
        height: size,
        position: "relative",
        transition: "transform 0.2s ease-out",
        transform: isActive ? `scale(${1.02 + audioLevel * 0.04})` : "scale(1)",
        filter: isActive ? "brightness(1.1)" : "brightness(1)",
        animation: isActive ? "orbGradientFlow 3s linear infinite" : ""
      }}
    >
      {/* Outer glow */}
      <div className="orb-layer-glow" style={{ opacity: isActive ? 1 : 0.6, transition: "opacity 0.5s ease" }} />

      <div className="orb-sphere" style={{ width: size, height: size, transform: `scale(${1 + audioLevel * 0.015})`, transition: "transform 0.1s ease-out" }}>
        {/* Base planet gradient */}
        <div className="orb-layer-base" />

        {/* Dynamic Internal Ripple Wave 1 (Soft white/gold highlights that overlay color changes) */}
        {isActive && audioLevel > 0.01 && (
          <div
            style={{
              position: "absolute",
              inset: "-10%",
              borderRadius: "50%",
              background: "radial-gradient(circle, rgba(255, 255, 255, 0.45) 0%, rgba(255, 171, 0, 0.2) 40%, transparent 70%)",
              mixBlendMode: "color-dodge",
              opacity: audioLevel * 0.4,
              transform: `scale(${1 + audioLevel * 0.15})`,
              transition: "transform 0.1s ease-out, opacity 0.1s ease-out",
              pointerEvents: "none",
            }}
          />
        )}

        {/* Dynamic Internal Ripple Wave 2 (Soft cyan highlight pulsating gently) */}
        {isActive && audioLevel > 0.01 && (
          <div
            style={{
              position: "absolute",
              inset: "-20%",
              borderRadius: "50%",
              background: "radial-gradient(circle, rgba(0, 240, 255, 0.25) 0%, transparent 60%)",
              mixBlendMode: "screen",
              opacity: audioLevel * 0.3,
              transform: `scale(${1.05 - audioLevel * 0.1})`,
              transition: "transform 0.12s ease-out, opacity 0.12s ease-out",
              pointerEvents: "none",
            }}
          />
        )}

        {/* Atmospheric highlight top-left */}
        <div className="orb-layer-highlight" />
        {/* Green atmospheric patch bottom-right */}
        <div className="orb-layer-atmosphere" />
        {/* Dark shadow bottom-right */}
        <div className="orb-layer-shadow" />
        {/* Noise/grain texture overlay */}
        <div className="orb-layer-noise" />
      </div>
    </div>
  );
}

/* ── Mini Orb (avatar) ──────────────────────────────────────────────────── */
function MiniOrb({ size = 28 }: { size?: number }) {
  return (
    <div
      style={{
        width: size,
        height: size,
        borderRadius: "50%",
        overflow: "hidden",
        flexShrink: 0,
        position: "relative",
      }}
    >
      <div
        style={{
          position: "absolute",
          inset: 0,
          borderRadius: "50%",
          background:
            "radial-gradient(ellipse at 35% 30%, #a8d8e8 0%, #7cbfcc 15%, #5aa8a8 28%, #4a9080 45%, #3d7860 60%, #2e5c48 75%, #152e22 90%)",
        }}
      />
      <div
        style={{
          position: "absolute",
          inset: 0,
          borderRadius: "50%",
          background:
            "radial-gradient(ellipse at 28% 22%, rgba(230,245,255,0.5) 0%, rgba(180,225,240,0.2) 25%, transparent 55%)",
        }}
      />
    </div>
  );
}

/* ── Dot indicator ──────────────────────────────────────────────────────── */
function NavDot({ color }: { color: string }) {
  return (
    <span
      style={{
        display: "inline-block",
        width: 7,
        height: 7,
        borderRadius: "50%",
        background: color,
        flexShrink: 0,
      }}
    />
  );
}

/* ── Mic Icon ───────────────────────────────────────────────────────────── */
function MicIcon() {
  return (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
      <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
      <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
      <line x1="12" y1="19" x2="12" y2="22" />
    </svg>
  );
}

/* ── Chevron Down ────────────────────────────────────────────────────────── */
function ChevronDown() {
  return (
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2.5"
      strokeLinecap="round"
      strokeLinejoin="round"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  );
}

